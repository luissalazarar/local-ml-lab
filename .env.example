APP_DISPLAY_NAME=Laboratorio ML
APP_PORT=3000
APP_ENV=production
APP_DEFAULT_LOCALE=es-PE
DATA_ROOT=/data
DATABASE_URL=sqlite:////data/db/app.sqlite3
QUEUE_URL=redis://queue:6379/0
ML_THREADS=2
WORKER_CONCURRENCY=1
MAX_UPLOAD_MIB=100
MAX_ROWS=200000
MAX_COLUMNS=300
MAX_CELLS=2000000
MAX_DECOMPRESSED_MIB=200
MAX_ARCHIVE_ENTRIES=2000
MAX_PROFILE_SAMPLE_ROWS=10000
MAX_FORECAST_PERIODS=10000
MAX_CLASS_LABELS=50
MAX_EXPANDED_FEATURES=5000
MAX_DENSE_MATRIX_MIB=64
MAX_CHILD_RSS_MIB=1536
MAX_SEARCH_SECONDS=1800
STORAGE_QUOTA_GIB=10
MIN_FREE_DISK_MIB=512
TEMP_RETENTION_HOURS=24
JOB_HEARTBEAT_SECONDS=3
JOB_STALE_SECONDS=60
CANCEL_GRACE_SECONDS=2
SHAP_ENABLED=false
LOG_LEVEL=INFO
LOG_MAX_MIB=10
LOG_BACKUP_COUNT=3
OPENAI_DEFAULT_MODEL=gpt-4.1-mini-2025-04-14
OPENAI_TIMEOUT_SECONDS=45
OPENAI_MAX_OUTPUT_TOKENS=2000
OPENAI_MAX_PAYLOAD_KIB=48
